{
  "name": "rainmap — もうすぐ雨 Slack 通知",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "毎5分",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "lat",
              "name": "lat",
              "value": 35.681236,
              "type": "number"
            },
            {
              "id": "lon",
              "name": "lon",
              "value": 139.767125,
              "type": "number"
            },
            {
              "id": "api_base",
              "name": "api_base",
              "value": "https://rainmap-api.ysk373.workers.dev",
              "type": "string"
            },
            {
              "id": "horizon_minutes",
              "name": "horizon_minutes",
              "value": 60,
              "type": "number"
            },
            {
              "id": "min_mmh",
              "name": "min_mmh",
              "value": 1,
              "type": "number"
            },
            {
              "id": "place_label",
              "name": "place_label",
              "value": "東京駅付近",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-watch-point",
      "name": "監視地点",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "url": "={{$json.api_base}}/api/v1/alerts/precip",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "lat", "value": "={{$json.lat}}" },
            { "name": "lon", "value": "={{$json.lon}}" },
            { "name": "horizon_minutes", "value": "={{$json.horizon_minutes}}" },
            { "name": "min_mmh", "value": "={{$json.min_mmh}}" },
            { "name": "z", "value": "8" }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-precip",
      "name": "降水アラートAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "notify",
              "leftValue": "={{$json.notify_recommended}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "not-stale",
              "leftValue": "={{$json.stale}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-notify",
      "name": "通知すべき？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "jsCode": "const alert = $('降水アラートAPI').item.json;\nconst watch = $('監視地点').item.json;\nconst key = `rainmap-onset:${watch.lat},${watch.lon}`;\nconst staticData = $getWorkflowStaticData('global');\nconst prev = staticData[key] || null;\nconst onsetKey = alert.onset ? (alert.onset.frame_id || alert.onset.time) : null;\n\nif (!onsetKey) {\n  return [{ json: { skip: true, reason: 'no_onset' } }];\n}\nif (prev === onsetKey) {\n  return [{ json: { skip: true, reason: 'duplicate_onset', onsetKey } }];\n}\n\nstaticData[key] = onsetKey;\n\nconst eta = alert.eta_minutes;\nconst label = alert.onset?.intensity_label || '雨';\nconst place = watch.place_label || `${watch.lat},${watch.lon}`;\nconst map = alert.map_url || '';\nconst etaText = eta == null ? 'まもなく' : `約 ${eta} 分後`;\n\nconst text = [\n  `☔ ${place}: もうすぐ雨が降りそうです（${etaText}・${label}）`,\n  map ? `地図: ${map}` : null,\n  '出典: 気象庁ナウキャスト（rainmap）',\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    skip: false,\n    onsetKey,\n    text,\n    alert,\n  },\n}];"
      },
      "id": "code-dedupe-message",
      "name": "重複抑制と文面",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "not-skip",
              "leftValue": "={{$json.skip}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-not-dup",
      "name": "未通知のonset？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "text": "={{$json.text}}",
        "otherOptions": {}
      },
      "id": "slack-post",
      "name": "Slack投稿",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1440, 0],
      "notesInFlow": true,
      "notes": "Slack 資格情報を接続し、投稿先チャンネルを選んでください。Incoming Webhook を使う場合はこのノードを HTTP Request POST に差し替え、JSON body {\"text\": $json.text} を送ってください。"
    }
  ],
  "connections": {
    "毎5分": {
      "main": [[{ "node": "監視地点", "type": "main", "index": 0 }]]
    },
    "監視地点": {
      "main": [[{ "node": "降水アラートAPI", "type": "main", "index": 0 }]]
    },
    "降水アラートAPI": {
      "main": [[{ "node": "通知すべき？", "type": "main", "index": 0 }]]
    },
    "通知すべき？": {
      "main": [
        [{ "node": "重複抑制と文面", "type": "main", "index": 0 }],
        []
      ]
    },
    "重複抑制と文面": {
      "main": [[{ "node": "未通知のonset？", "type": "main", "index": 0 }]]
    },
    "未通知のonset？": {
      "main": [
        [{ "node": "Slack投稿", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "rainmap GET /api/v1/alerts/precip をポーリングし、notify_recommended のとき Slack へ『もうすぐ雨』を投稿する。"
  }
}
